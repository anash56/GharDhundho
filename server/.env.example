# Copy to server/.env and fill in the local values.
NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/ghardhundho

# Required: at least 32 characters; use a cryptographically random secret.
JWT_SECRET=

# JWT sessions and the auth cookie expire after 24 hours.
CLIENT_URL=http://localhost:5173

# Cookie policy: use lax for same-site deployment. Use none only when
# frontend/API are intentionally cross-site; production HTTPS is required.
AUTH_COOKIE_SAME_SITE=lax

# Set only when behind a trusted reverse proxy. Example: TRUST_PROXY_HOPS=1
# Leave unset for local development.
# TRUST_PROXY_HOPS=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
