{
    "name": "ghardhundho",
    "private": true,
    "scripts": {
        "dev": "concurrently \"npm run dev --prefix server\" \"npm run dev --prefix client\"",
        "seed": "npm run seed --prefix server",
        "build": "npm run build --prefix client",
        "lint": "npm run lint --prefix client && npm run lint --prefix server && eslint e2e",
        "format": "npm run format --prefix client && npm run format --prefix server && prettier --write \"e2e/**/*.js\"",
        "test:e2e": "playwright test --config=e2e/playwright.config.js",
        "test:e2e:ui": "playwright test --ui --config=e2e/playwright.config.js",
        "test:e2e:headed": "playwright test --headed --config=e2e/playwright.config.js",
        "test:e2e:report": "playwright show-report e2e/playwright-report"
    },
    "devDependencies": {
        "@axe-core/playwright": "^4.14.0",
        "@eslint/js": "^9.19.0",
        "@playwright/test": "^1.64.1",
        "concurrently": "^9.1.2",
        "eslint": "^9.19.0",
        "eslint-plugin-react": "^7.37.4",
        "eslint-plugin-react-hooks": "^5.1.0",
        "eslint-plugin-react-refresh": "^0.4.18",
        "globals": "^15.14.0",
        "prettier": "^3.4.2"
    }
}